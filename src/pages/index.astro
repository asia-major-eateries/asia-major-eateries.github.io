---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pillars } from '../data/site';
---
<BaseLayout>
  <section class="hero"><div class="container hero-grid"><div class="copy"><p class="eyebrow">Asia Major Eateries</p><h1>Find what’s good, right now.</h1><p class="lede">One home for the whole restaurant group—locations, current hours, maps, ratings, menus, live item availability, price ranges, ordering and reservations.</p><div class="actions"><a class="button primary" href="/locations/">Explore locations</a><a class="button secondary" href="/menus/">Browse menus</a></div></div><div class="art" aria-hidden="true"><div class="plate"><span>AME</span></div><div class="orbit one"></div><div class="orbit two"></div></div></div></section>
  <section class="section"><div class="container"><div class="intro"><p class="eyebrow">One group, location-aware</p><h2>The useful details should never be hard to find.</h2><p class="lede">Restaurant information changes throughout the day. AME is designed so the public site can combine stable location pages with fresh menu and availability data from the operating platform.</p></div><div class="grid pillars">{pillars.map(([title,body]) => <article class="card pillar"><h3>{title}</h3><p>{body}</p></article>)}</div></div></section>
  <section class="section dark"><div class="container split"><div><p class="eyebrow">Live restaurant data</p><h2>Static brand, dynamic operations.</h2></div><p class="lede">Addresses, maps and restaurant stories can be stable. Item availability, prices, special hours and service interruptions come from the API with freshness timestamps so guests can see when information was last observed.</p></div></section>
</BaseLayout>
<style>
.hero{min-height:calc(100svh - 76px);display:grid;align-items:center;overflow:hidden;border-bottom:1px solid var(--line);background:radial-gradient(circle at 80% 10%,rgba(210,156,65,.22),transparent 36%),linear-gradient(135deg,#fbf7ef,#f1e5d1)}.hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:60px;align-items:center;padding-block:88px}.copy{display:grid;gap:26px}.actions{display:flex;gap:12px;flex-wrap:wrap}.art{position:relative;min-height:500px;display:grid;place-items:center}.plate{width:min(34vw,370px);aspect-ratio:1;border-radius:50%;background:var(--ink);box-shadow:var(--shadow);display:grid;place-items:center;position:relative;z-index:2}.plate::before{content:"";position:absolute;inset:11%;border:1px solid rgba(244,198,110,.5);border-radius:inherit}.plate span{color:var(--gold2);font:900 clamp(2rem,5vw,4.5rem)/1 Georgia,serif;letter-spacing:.12em}.orbit{position:absolute;border-radius:50%;border:1px solid rgba(23,20,15,.18)}.orbit.one{width:95%;aspect-ratio:1}.orbit.two{width:68%;aspect-ratio:1;transform:translate(24%,-22%);border-color:rgba(169,66,47,.3)}.intro{display:grid;grid-template-columns:.55fr 1.2fr 1fr;gap:32px;align-items:start}.pillars{grid-template-columns:repeat(3,1fr);margin-top:52px}.pillar{padding:30px;min-height:230px;display:flex;flex-direction:column;justify-content:space-between}.pillar p{color:var(--muted)}.dark{background:var(--ink);color:var(--paper)}.dark .lede{color:#d4c8b7}.split{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:end}@media(max-width:820px){.hero-grid,.intro,.split{grid-template-columns:1fr}.art{min-height:320px;order:-1}.plate{width:min(70vw,290px)}.pillars{grid-template-columns:1fr}}
</style>
