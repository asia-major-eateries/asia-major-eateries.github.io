---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { menuDishes, menuPrinciples } from '../../data/menu';
---
<BaseLayout title="Menus" description="Explore the Asia Major Eateries core pan-Asian menu, with lower-glycemic options, vegan preparations, no added MSG and locally sourced options.">
  <section class="section intro">
    <div class="container page">
      <p class="eyebrow">Menus</p>
      <h1>One core menu. A little local character.</h1>
      <p class="lede">
        About 95% of the menu is shared across locations. Seasonal produce, local sourcing, availability and a small number of restaurant-specific dishes can vary by store.
      </p>
      <div class="principles" aria-label="Menu principles">
        {menuPrinciples.map((principle) => <span>{principle}</span>)}
      </div>
      <a class="button primary" href="/locations/">Choose a location</a>
    </div>
  </section>

  <section class="section menu-section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Core dishes</p>
          <h2>Across Asia, built for flexibility.</h2>
        </div>
        <p>
          Every core dish defaults to meat or seafood, with a vegan preparation and a lower-glycemic base or swap available. We do not add MSG and prioritize organic and locally grown ingredients when available.
        </p>
      </div>

      <div class="grid dish-grid">
        {menuDishes.map((dish) => (
          <article class="card dish-card">
            <img
              class="dish-photo"
              src={dish.image}
              alt={dish.alt}
              width="400"
              height="300"
              loading="lazy"
              decoding="async"
            />
            <div class="dish-copy">
              <p class="eyebrow">{dish.country}</p>
              <h3>{dish.name}</h3>
              <p>{dish.description}</p>
              <div class="dish-meta">
                <span>Default: {dish.defaultProtein}</span>
                <span>Vegan option</span>
                <span>{dish.lowerGlycemicSwap}</span>
                <span>No added MSG</span>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="location-note card">
        <div>
          <p class="eyebrow">The remaining ~5%</p>
          <h3>Let each restaurant respond to its market.</h3>
        </div>
        <p>
          A location can rotate a few dishes, produce choices or proteins without changing the dependable core menu. Current pricing, availability and exact modifiers live on each restaurant page.
        </p>
        <a class="button secondary" href="/locations/">View locations</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page{display:grid;gap:26px}.page .button{justify-self:start}.intro{padding-bottom:72px}.principles{display:flex;flex-wrap:wrap;gap:10px;max-width:980px}.principles span,.dish-meta span{border:1px solid var(--line);border-radius:999px;background:rgba(255,253,248,.7);padding:.48rem .74rem;font-size:.82rem;font-weight:800}.menu-section{background:var(--paper2)}.section-head{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:36px;align-items:end;margin-bottom:36px}.section-head>div{display:grid;gap:12px}.section-head>p{color:var(--muted);max-width:54ch}.dish-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.dish-card{overflow:hidden}.dish-photo{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;background:var(--paper);border-bottom:1px solid var(--line)}.dish-copy{padding:26px;display:grid;gap:12px}.dish-copy>p:not(.eyebrow){color:var(--muted)}.dish-meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}.dish-meta span:nth-child(2){border-color:rgba(56,102,65,.38);color:var(--green)}.location-note{margin-top:34px;padding:28px;display:grid;grid-template-columns:1fr 1.15fr auto;gap:24px;align-items:center}.location-note>div{display:grid;gap:9px}.location-note>p{color:var(--muted)}
  @media(max-width:820px){.section-head,.location-note{grid-template-columns:1fr}.dish-grid{grid-template-columns:1fr}.location-note .button{justify-self:start}}
</style>
