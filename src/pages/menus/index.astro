import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Menus" description="Browse Asia Major Eateries menus by restaurant location, with live availability and current price ranges."><section class="section"><div class="container page"><p class="eyebrow">Menus</p><h1>Menus belong to a location.</h1><p class="lede">Prices, modifiers and availability can differ by restaurant. Choose a location first so we can show the correct menu and its current operational state.</p><a class="button primary" href="/locations/">Choose a location</a></div></section></BaseLayout>
<style>.page{display:grid;gap:26px}.page .button{justify-self:start}</style>
