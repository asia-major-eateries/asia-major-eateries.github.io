{
  "name": "asia-major-eateries.github.io",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Astro marketing and live restaurant-location discovery site for Asia Major Eateries.",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-built-site.mjs",
